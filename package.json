{
  "name": "sendermaster-ops",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 3010",
    "test": "tsx --test tests/*.test.ts",
    "db:deploy": "prisma migrate deploy",
    "owner:init": "tsx scripts/init-owner.ts",
    "typecheck": "tsc --noEmit",
    "contract:generate": "openapi-typescript contracts/openapi.json -o lib/api-types.ts",
    "admin:recover": "tsx scripts/reset-admin.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "next": "16.3.8",
    "otpauth": "9.5.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "openapi-typescript": "^7.13.0",
    "prisma": "6.19.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}

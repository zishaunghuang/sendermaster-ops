# Independent database and role. Never use robot_store DATABASE_URL.
DATABASE_URL=postgresql://sendermaster_ops:CHANGE_ME@127.0.0.1:5432/sendermaster_ops
OPS_ORIGIN=https://ops.sendermaster.com
CORE_INTERNAL_URL=http://127.0.0.1:3000
# 32 random bytes in hex. Back up securely; lost key requires MFA enrollment reset.
MFA_ENCRYPTION_KEY=
# Ed25519 PKCS8 PEM; literal \n supported. Core receives only the public key.
OPS_SIGNING_PRIVATE_KEY=

[Unit]
Description=SenderMaster independent operations portal
After=network.target postgresql@14-main.service
Wants=postgresql@14-main.service
[Service]
Type=simple
User=sendermaster-ops
Group=sendermaster-ops
WorkingDirectory=/var/sofi/sendermaster-ops/current
EnvironmentFile=/etc/sendermaster-ops/environment
Environment=NODE_ENV=production
Environment=PATH=/opt/sendermaster-ops/runtime/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/sendermaster-ops/runtime/bin/node /var/sofi/sendermaster-ops/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3010
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
InaccessiblePaths=-/var/sofi/robot_store -/etc/robot-store
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/var/sofi/sendermaster-ops/current/.next/cache
MemoryMax=768M
CPUQuota=100%
UMask=0077
[Install]
WantedBy=multi-user.target

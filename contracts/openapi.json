  "paths": {
    "/v2/internal/ops/overview": {
      "get": {
        "operationId": "overview",
        "parameters": [],
        "security": [
          {
            "OpsClaims": [],
            "OpsSignature": []
          }
        ],
        "responses": {
          "200": {
            "description": "Persisted result. Writes can remain PENDING; poll operations/{id} after timeouts.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Overview"
                }
              }
            }
          },
          "401": {
            "description": "Invalid signature, replay, expired claims or non-loopback caller"
          },
          "403": {
            "description": "Role or recent MFA requirement"
          },
          "409": {
            "description": "Version conflict or changed review batch"
          }
        }
      }
    },

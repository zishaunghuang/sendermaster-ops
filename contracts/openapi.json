  "components": {
    "schemas": {
      "Command": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "operationId",
          "organizationId",
          "action",
          "reason",
          "version"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "minLength": 16,
            "maxLength": 100
          },
          "organizationId": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "policy",
              "pause",
              "resume",
              "release",
              "cancel",
              "alert-resolve"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 5,
            "maxLength": 1000
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "limitMode": {
            "type": "string",
            "enum": [
              "observe",
              "enforce"
            ]
          },
          "ratePerSecond": {
            "type": "number",
            "nullable": true,
            "minimum": 0.01
          },
          "rollingDayLimit": {
            "type": "integer",
            "nullable": true,
            "minimum": 1
          },
          "batchId": {
            "type": "string"
          },
          "alertId": {
            "type": "string"
          }
        }
      },
      "Review": {
        "type": "object",
        "required": [
          "organizationId",
          "taskIds"
        ],
        "properties": {
          "organizationId": {
            "type": "string"
          },
          "taskIds": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 100
          }
        }
      },
      "Overview": {
        "type": "object",
        "required": [
          "organizations",
          "tenants",
          "paused",
          "held",
          "alerts",
          "sent"
        ],
        "properties": {
          "organizations": {
            "type": "integer",
            "minimum": 0
          },
          "tenants": {
            "type": "integer",
            "minimum": 0
          },
          "paused": {
            "type": "integer",
            "minimum": 0
          },
          "held": {
            "type": "integer",
            "minimum": 0
          },
          "alerts": {
            "type": "integer",
            "minimum": 0
          },
          "sent": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Operation": {
        "type": "object",
        "required": [
          "id",
          "actorId",
          "actorRole",
          "action",
          "status",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "actorId": {
            "type": "string"
          },
          "actorRole": {
            "type": "string"
          },
          "organizationId": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "createdAt": {
            "type": "string"
          },
          "updatedAt": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "securitySchemes": {
      "OpsClaims": {
        "type": "apiKey",
        "in": "header",
        "name": "x-ops-claims"
      },
      "OpsSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "x-ops-signature"
      }
    }
  }
}
